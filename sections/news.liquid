{{ 'section-news.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #section-{{ section.id }}{
    padding-bottom: {{ section.settings.padding_bottom_pc }}px;
  }
  @media screen and (max-width: 767px) {
    #section-{{ section.id }}{
      padding-bottom: {{ section.settings.padding_bottom_sp }}px;
    }
  }
{%- endstyle -%}

{% if section.settings.blog != blank %}
  {% assign blog = blogs[section.settings.blog] %}

  <section id="section-{{ section.id }}" class="news">
    <h2 class="news-title">{{ section.settings.heading }}</h2>
    <ul class="news-list page-width">
      {% for article in blog.articles limit: section.settings.post_limit %}
        <li>
          <a href="{{ article.url }}" class="news-list-text">
            <p class="news-list-date">{{ article.published_at | date: "%Y.%m.%d" }}</p>
            <p class="news-list-title">{{ article.title }}</p>
          </a>
        </li>
      {% endfor %}
    </ul>
  </section>

{% endif %}

{% schema %}
{
  "name": "ニュース一覧",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "表示するブログ"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "表示件数",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "padding_bottom_pc",
      "label": "下余白(PC)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_sp",
      "label": "下余白(SP)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "ニュース一覧"
    }
  ]
}
{% endschema %}