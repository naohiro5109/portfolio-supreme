{{ 'section-tab-collection-list.css' | asset_url | stylesheet_tag }}

<section>
  <div class="page-width">
    <div class="tabs">
      <div class="tab-buttons">
        {% for block in section.blocks %}
          {% assign collection = collections[block.settings.collection] %}
          <button class="tab-button {% if forloop.first %}active{% endif %}" data-tab="tab{{ forloop.index }}">{{ collection.title }}</button>
        {% endfor %}
      </div>

      {% for block in section.blocks %}
        <div class="tab-content {% if forloop.first %}active{% endif %}" id="tab{{ forloop.index }}">
          <ul class="tab-content-list">
            {% assign collection = collections[block.settings.collection] %}
            {% for product in collection.products limit: 10 %}
              {% render 'card-product', card_product: product, section_id: section.id %}
            {% endfor %}
          </ul>
        </div>
      {% endfor %}
    </div>
  </div>
</section>


<script src="{{ 'section-tab-collection-list.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "タブメニュー商品リスト",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "タイトル",
      "default": "見出し"
    }
  ],
  "blocks": [
    {
      "type": "tab_block",
      "name": "タブメニューブロック",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "タブボタン"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "コレクション"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "タブメニュー商品リスト"
    }
  ]
}
{% endschema %}