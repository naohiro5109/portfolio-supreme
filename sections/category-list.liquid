{{ 'section-category-list.css' | asset_url | stylesheet_tag }}

<section class="section-category-list">
  <div class="page-width">
    {% render 'title', color: 'white', section_title: 'section_title' %}

    <ul class="category-list">
      {% for block in section.blocks %}
        {% if block.settings.img_pc != blank %}
          <li {{ block.shopify_attributes }}>
            {% if block.settings.url != blank %}
              <a href="{{ block.settings.url }}">
            {% endif %}

            <picture>
              {% if block.settings.img_sp != blank %}
                <source media="(max-width: 768px)" srcset="{{ block.settings.img_sp | image_url }}">
              {% endif %}

              <img
                src="{{ block.settings.img_pc | image_url }}"
                alt="{{ block.settings.alt }}"
                width="100%"
                height="auto"
                loading="lazy"
                class="category-list-img"
              >
            </picture>

            <p class="category-list-name">{{ block.settings.name }}</p>

            {% if block.settings.url != blank %}
              </a>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "カテゴリーリスト",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "セクションタイトル"
    }
  ],
  "blocks": [
    {
      "type": "category_block",
      "name": "カテゴリーブロック",
      "settings": [
        {
          "type": "url",
          "id": "url",
          "label": "カテゴリーURL"
        },
        {
          "type": "image_picker",
          "id": "img_pc",
          "label": "カテゴリー画像(PC)"
        },
        {
          "type": "image_picker",
          "id": "img_sp",
          "label": "カテゴリー画像(SP)"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "カテゴリー画像代替テキスト"
        },
        {
          "type": "textarea",
          "id": "name",
          "label": "カテゴリーネーム"
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "カテゴリーリスト"
    }
  ]
}
{% endschema %}