{{ 'section-season-list.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #section-{{ section.id }}{
    padding-bottom: {{ section.settings.padding_bottom_pc }}px;
  }
  @media screen and (max-width: 767px) {
    #section-{{ section.id }}{
      padding-bottom: {{ section.settings.padding_bottom_sp }}px;
    }
  }
{%- endstyle -%}

<section id="section-{{ section.id }}" class="section-season-list">
  <div class="page-width">
    {% render 'title', color: 'white', section_title: 'section_title' %}

    <ul class="season-list">
      {% for block in section.blocks %}
        {% if block.settings.text != blank %}
          <li {{ block.shopify_attributes }}>
            {% if block.settings.url != blank %}
              <a href="{{ block.settings.url }}" class="season-list-button">
            {% endif %}

            {{ block.settings.text }}

            {% if block.settings.url != blank %}
              </a>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "シーズンリスト",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "セクションタイトル",
    },
    {
      "type": "range",
      "id": "padding_bottom_pc",
      "label": "下余白(PC)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_sp",
      "label": "下余白(SP)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "season_block",
      "name": "シーズンブロック",
      "settings": [
        {
          "type": "url",
          "id": "url",
          "label": "シーズンURL"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "ボタンテキスト"
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "シーズンリスト"
    }
  ]
}
{% endschema %}