{{ 'section-season-list.css' | asset_url | stylesheet_tag }}

<section class="section-season-list">
  <div class="page-width">
    {% render 'title', color: 'white', section_title: 'section_title' %}

    <ul class="season-list">
      {% for block in section.blocks %}
        {% if block.settings.text != blank %}
          <li {{ block.shopify_attributes }}>
            {% if block.settings.url != blank %}
              <a href="{{ block.settings.url }}" class="season-list-button">
            {% endif %}

            {{ block.settings.text }}

            {% if block.settings.url != blank %}
              </a>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "シーズンリスト",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "セクションタイトル",
    },
  ],
  "blocks": [
    {
      "type": "season_block",
      "name": "シーズンブロック",
      "settings": [
        {
          "type": "url",
          "id": "url",
          "label": "シーズンURL"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "ボタンテキスト"
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "シーズンリスト"
    }
  ]
}
{% endschema %}